<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Top spacer (1/3 position) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- App title matching iOS LaunchScreen.storyboard -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/splash_title"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Middle spacer (2/3 remaining space) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- Subtitle matching iOS LaunchScreen.storyboard -->
    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Powered by React Native"
        android:textColor="@color/splash_subtitle"
        android:textSize="17sp" />

</LinearLayout>
